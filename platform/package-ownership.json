{
  "$schema": "./package-ownership.schema.json",
  "rules": {
    "agent-contracts": { "owner": "Agent Core", "mayDependOn": [] },
    "agent-runtime-conformance": { "owner": "Quality", "mayDependOn": ["agent-contracts", "agent-lib"] },
    "agent-platform-conformance": { "owner": "Quality", "mayDependOn": ["agent-runtime-conformance"] },
    "evidence-digest": { "owner": "Examples", "mayDependOn": ["agent-platform-conformance", "agent-package-release", "agent-runtime-conformance", "harness-pi"] },
    "app-contracts": { "owner": "Application", "mayDependOn": [] },
    "agent-lib": { "owner": "Agent Core", "mayDependOn": ["agent-contracts", "platform-ports"] },
