{
  "name": "@sage/agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "check:ui-tokens": "node scripts/check-ui-target-tokens.mjs",
    "preview": "vite preview",
    "screenshots": "tsx scripts/screenshots.ts",
    "browser-smoke": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@sage/app-contracts": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
