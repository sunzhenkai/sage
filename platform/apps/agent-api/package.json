{
  "name": "@sage/agent-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsx src/runtime.ts",
    "start": "node dist/runtime.js",
    "register-package": "tsx scripts/register-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sage/agent-client": "workspace:*",
    "@sage/agent-contracts": "workspace:*",
    "@sage/agent-package-release": "workspace:*",
    "@sage/agent-release-registry": "workspace:*",
    "@sage/agent-run-admission": "workspace:*",
    "@sage/app-contracts": "workspace:*",
    "@sage/chat-domain": "workspace:*",
    "@sage/harness-pi": "workspace:*",
    "@sage/local-fakes": "workspace:*",
    "@sage/local-runtime": "workspace:*",
    "@sage/observability": "workspace:*",
    "@sage/platform-ports": "workspace:*",
    "@sage/production-governance": "workspace:*",
    "@sage/provider-catalog": "workspace:*",
    "@sage/secret-vault": "workspace:*",
    "@sage/task-domain": "workspace:*",
    "@sage/task-store-postgres": "workspace:*",
    "@sage/temporal-registry": "workspace:*",
    "@sage/temporal-routing": "workspace:*",
    "@temporalio/client": "1.22.0",
    "fastify": "5.11.3",
    "pg": "8.23.0",
    "typebox": "1.3.13"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
