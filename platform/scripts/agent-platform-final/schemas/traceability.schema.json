{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sage://agent-platform-final/traceability/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","sourceRevision","sourceDigest","toolDigest","modelDigest","dslDigest","rows","contentDigest"],
  "properties":{
    "schemaVersion":{"const":"1"},
    "sourceRevision":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "sourceDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "toolDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "rows":{"type":"array","minItems":19,"items":{"type":"object","additionalProperties":false,"required":["invariantId","designAnchor","modelIds","dslRefs","owner","paths","requirementSlug","requirementTitle","taskIds","caseIds","evidence"],"properties":{"taskIds":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^\\d+\\.\\d+$"}},"caseIds":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^apgv/[a-z0-9-]+/v1/[a-z0-9-]+$"}},"evidence":{"type":"object","required":["ref","digest"],"properties":{"digest":{"type":["string","null"]}}}}}},
    "contentDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
  }
}
